APP_NAME="Yousif Elfarra Portfolio"
APP_ENV=local
APP_KEY=base64:ij1JBX1U2SUNwlZhLeP+0nwtIwXJImXa+yO9q54WNUk=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

